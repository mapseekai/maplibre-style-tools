{
  "name": "maplibre-style-tools",
  "version": "0.0.0",
  "description": "AI SDK tools for inspecting and editing MapLibre styles.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('.tmp/tsconfig.build.tsbuildinfo', { force: true });\"",
    "prebuild": "pnpm run clean",
    "build": "tsc -b tsconfig.build.json",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck": "pnpm run typecheck:core && tsc -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('.tmp/test-dist', { recursive: true, force: true });\"",
    "test": "tsc -p tsconfig.test.json",
    "posttest": "node scripts/run-tests.mjs",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.10.0",
  "peerDependencies": {
    "maplibre-gl": "^6.3.0"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.2.1",
    "ai": "^6.0.141",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "eslint": "^9.39.4",
    "maplibre-gl": "^6.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
